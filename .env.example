## サーバー設定
# クライアントのビルド成果物の場所。ローカルは client/dist (Docker イメージは /app/public)。
STATIC_DIR=client/dist

# 地図に出す指標。acmap=最大加速度 / jma=リアルタイム震度 / vcmap=最大速度 / dcmap=最大変位
KMONI_LAYER=acmap

# 上流 API (強震モニタ・P2P地震情報) へプロキシ経由で出るときに設定する。未設定なら直接接続。
# UPSTREAM_API_PROXY_URL=http://proxy.example.com:8080

# EEW イベントを外部システムへ通知する webhook の POST 先。未設定なら無効。
# カンマ区切りで複数指定できる。UPSTREAM_API_PROXY_URL の影響は受けず常に直接接続。
# EEW_WEBHOOK_URL=http://192.168.1.10:8000/webhook
# EEW_WEBHOOK_TIMEOUT_MS=5000
