# サーバーの設定例。docker compose では docker-compose.yml の environment を使う。
# ローカルで動かすときは `set -a; . ./.env; set +a` などで読み込む。

# --- devcontainer 用 (アプリは参照しない) ---------------------------------
# 社内プロキシの要否は .devcontainer/initializeCommand.sh が起動のたびに判定し、
# 下記 3 つを .env へ自動で書き込む。手で書く必要はない。
#   PROXY_URL        : apt / npm / docker build などの一般通信用 (hope)
#   CLAUDE_PROXY_URL : Claude Code 専用 (keith)
#   PROXY_NO_PROXY   : プロキシを通さないホスト一覧
# 判定はプロキシホストの名前解決可否のみで行うため、誤判定する場合は
# PROXY_MODE を office / home に書き換えて固定する。
PROXY_MODE=auto

PORT=8080
HOST=0.0.0.0
STATIC_DIR=client/dist
LOG_LEVEL=info
TZ=Asia/Tokyo

# 利用地・津波予報区・表示はサーバーでは持たない。
# 端末ごとにパネルの「設定」で決める (localStorage / URL パラメータ)。

# 強震モニタ
# 実測で kmoni は毎秒更新 (docs/kmoni-endpoints.md)。
# NIED への負荷を抑えたい場合は 2 (秒) に落とす。
KMONI_BASE_URL=http://www.kmoni.bosai.go.jp
KMONI_IDLE_FRAME_INTERVAL_SEC=1
KMONI_ACTIVE_FRAME_INTERVAL_SEC=1
KMONI_EEW_INTERVAL_MS=1000
KMONI_CLOCK_SYNC_INTERVAL_MS=60000
KMONI_REQUEST_TIMEOUT_MS=4000
KMONI_DEGRADE_AFTER_FAILURES=5
KMONI_FRAME_CACHE_SIZE=30

# P2P地震情報 (WebSocket は IP あたり 2 本まで。サーバーが 1 本だけ張る)
P2P_WS_URL=wss://api.p2pquake.net/v2/ws
P2P_HISTORY_URL=https://api.p2pquake.net/v2/history

# クライアント WS のハートビート。リバースプロキシのアイドル切断より短くする。
WS_HEARTBEAT_MS=30000
QUAKE_HISTORY_SIZE=12
EEW_RETENTION_MS=180000
