# サーバー設定。npm start が --env-file-if-exists=.env で読む。
# 既定のままでよい項目は書かない (既定は server/src/config.ts、一覧は README)。
# 使うときは cp .env.example .env

# クライアントのビルド成果物の場所。ローカルは client/dist (Docker イメージは /app/public)。
STATIC_DIR=client/dist

# 地図に出す指標。acmap=最大加速度 / jma=リアルタイム震度 / vcmap=最大速度 / dcmap=最大変位
KMONI_LAYER=acmap

# 上流 API (強震モニタ・P2P地震情報) へプロキシ経由で出るときに設定する。
# HTTP 取得も WebSocket も同じ値を使う。未設定なら直接接続。
# UPSTREAM_API_PROXY_URL=http://proxy.example.com:8080
